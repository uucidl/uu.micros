#if defined(_WIN32)
LIB "opengl32"
LIB "ole32"
#else
LIB "OpenGL"
#if defined(__linux__)
LIB "GLX"
LIB "pipewire-0.3"
#endif
#endif

#include "micros/preprocessor.h"

#if defined(_WIN32)
#define OS NT
#elif defined(__APPLE__) && defined(__MACH__)
#define OS Darwin
#elif defined(__linux__)
#define OS Linux
#endif


#if (defined(_MSC_VER) && defined(_M_X64)) || ((defined(__clang__) || defined(__GNUC__)) && defined(__x86_64__))
#define CPU x64
#elif (defined(_MSC_VER) && defined(_M_IX86)) || ((defined(__clang__) || defined(__GNUC__)) && defined(__i386__))
#define CPU x86
#endif

#define OS_CPU CONCAT(CONCAT(OS,_), CPU)

LIBDIR PATH(../libs/,OS_CPU)

